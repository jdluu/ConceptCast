{
  "name": "concept-cast-monorepo",
  "private": true,
  "scripts": {
    "dev": "infisical run --path=/ai -- turbo run dev worker",
    "dev:backend": "infisical run --path=/ai -- turbo run dev --filter=backend",
    "dev:frontend": "infisical run --path=/ai -- turbo run dev --filter=concept-cast-frontend",
    "dev:worker": "infisical run --path=/ai -- turbo run worker --filter=backend",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "update": "turbo run update",
    "bootstrap": "turbo run bootstrap",
    "setup": "make setup",
    "clean": "rm -rf node_modules apps/*/node_modules"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "turbo": "^2.8.15"
  }
}
