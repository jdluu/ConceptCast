# --- Infisical Configuration ---
# The frontend uses 'infisical run -- vite' to inject dashboard secrets at runtime.
# You only need these locally to authorize the CLI.
INFISICAL_TOKEN=your_machine_identity_client_secret
INFISICAL_PROJECT_ID=your_infisical_project_id
INFISICAL_ENV=dev

# --- Fallback Configuration ---
# Vite requires VITE_ prefix for environment variables to be bundled.
VITE_API_URL=http://localhost:8000
