{
  "openapi": "3.1.0",
  "info": { "title": "ConceptCast Backend", "version": "0.1.0" },
  "paths": {
    "/models/available": {
      "get": {
        "summary": "Get Available Models",
        "description": "Retrieves the list of supported AI providers and their models.\n\nOnly includes providers for which the user has an API key configured; mock is always included.\nNo tiered priority.",
        "operationId": "get_available_models_models_available_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AvailableModelsResponse" }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Read Root",
        "description": "Root health-check endpoint (used when frontend is not bundled).",
        "operationId": "read_root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": { "type": "string" },
                  "type": "object",
                  "title": "Response Read Root  Get"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/create": {
      "post": {
        "summary": "Create Job",
        "description": "Initializes a new asynchronous video generation job.\n\nCreates a job record in the database and triggers the background processing workflow.\n\nArgs:\n    request: The job configuration (topic, audience, provider).\n    background_tasks: FastAPI BackgroundTasks handler.\n    db: The asynchronous database session.\n\nReturns:\n    JobStatus: The initial status of the created job.\n\nRaises:\n    HTTPException: If job initialization fails.",
        "operationId": "create_job_jobs_create_post",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/JobRequest" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/JobStatus" } }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/status": {
      "get": {
        "summary": "Get Job Status",
        "description": "Retrieves the current status and artifacts for a specific job.\n\nArgs:\n    job_id: The UUID of the job to retrieve.\n    db: The asynchronous database session.\n\nReturns:\n    JobStatus: Detailed state including plan, storyboard, and video URL if available.\n\nRaises:\n    HTTPException: If job is not found.",
        "operationId": "get_job_status_jobs__job_id__status_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "title": "Job Id" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/JobStatus" } }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/events": {
      "get": {
        "summary": "Job Events",
        "description": "Provides a real-time stream of job updates via SSE.\n\nArgs:\n    job_id: The UUID of the job to stream events for.\n    db_session_factory: Factory for non-blocking DB sessions.\n\nReturns:\n    StreamingResponse: An event-stream connection.",
        "operationId": "job_events_jobs__job_id__events_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "title": "Job Id" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": { "application/json": { "schema": {} } }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/plan": {
      "get": {
        "summary": "Get Plan",
        "description": "Retrieves the generated curriculum plan for a specific job.\n\nArgs:\n    job_id: The UUID of the job.\n    db: The asynchronous database session.\n\nReturns:\n    CurriculumPlan: The parsed curriculum JSON.\n\nRaises:\n    HTTPException: If job or plan is not found.",
        "operationId": "get_plan_jobs__job_id__plan_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "title": "Job Id" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CurriculumPlan" } }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AvailableModelsResponse": {
        "properties": {
          "available": {
            "items": { "$ref": "#/components/schemas/ProviderModels" },
            "type": "array",
            "title": "Available"
          }
        },
        "type": "object",
        "required": ["available"],
        "title": "AvailableModelsResponse"
      },
      "CurriculumPlan": {
        "properties": {
          "concept_title": {
            "type": "string",
            "title": "Concept Title",
            "description": "Title of the main concept"
          },
          "target_audience": {
            "type": "string",
            "title": "Target Audience",
            "description": "Level (e.g., 'Undergraduate CS')"
          },
          "teaching_steps": {
            "items": { "$ref": "#/components/schemas/TeachingStep" },
            "type": "array",
            "title": "Teaching Steps",
            "description": "Ordered steps"
          }
        },
        "type": "object",
        "required": ["concept_title", "target_audience", "teaching_steps"],
        "title": "CurriculumPlan",
        "description": "Top-level plan containing the full sequence of teaching steps for a topic.\n\nAttributes:\n    concept_title (str): Title of the main concept.\n    target_audience (str): Target audience level (e.g., 'Undergraduate CS').\n    teaching_steps (list[TeachingStep]): Ordered list of teaching steps."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobRequest": {
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic",
            "description": "The main concept to explain"
          },
          "target_audience": {
            "type": "string",
            "title": "Target Audience",
            "description": "Optional knowledge level",
            "default": "Undergraduate CS"
          },
          "provider": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Provider",
            "description": "Explicit model provider"
          },
          "model_id": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Model Id",
            "description": "Explicit model ID"
          }
        },
        "type": "object",
        "required": ["topic"],
        "title": "JobRequest",
        "description": "Request model for creating a new job.\n\nAttributes:\n    topic (str): The main concept to explain.\n    target_audience (str): The intended audience knowledge level.\n    provider (str | None): Explicit AI model provider to use.\n    model_id (str | None): Explicit model ID to use."
      },
      "JobStatus": {
        "properties": {
          "job_id": { "type": "string", "title": "Job Id" },
          "streamed_thoughts": {
            "items": { "$ref": "#/components/schemas/ThoughtLog" },
            "type": "array",
            "title": "Streamed Thoughts",
            "description": "Live stream of agent thoughts (agent, phase, content, ts)."
          },
          "status": {
            "type": "string",
            "enum": [
              "planning",
              "validating",
              "architecting",
              "rendering",
              "reviewing",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "current_step": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Current Step"
          },
          "plan": {
            "anyOf": [{ "$ref": "#/components/schemas/CurriculumPlan" }, { "type": "null" }]
          },
          "validation": {
            "anyOf": [{ "$ref": "#/components/schemas/ValidationResult" }, { "type": "null" }]
          },
          "storyboard": {
            "anyOf": [{ "$ref": "#/components/schemas/Storyboard" }, { "type": "null" }]
          },
          "manim_code": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Manim Code"
          },
          "video_url": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Video Url"
          },
          "error": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Error" },
          "mode": {
            "type": "string",
            "enum": ["live", "mock"],
            "title": "Mode",
            "description": "Execution mode: 'live' uses real AI APIs, 'mock' uses local simulated responses",
            "default": "live"
          }
        },
        "type": "object",
        "required": ["job_id", "status"],
        "title": "JobStatus",
        "description": "Status tracking model for a ConceptCast generation job.\n\nAttributes:\n    job_id (str): Unique UUID for the job.\n    status (str): Current processing status (planning, validating, etc.).\n    current_step (str | None): Detail on the specific sub-step execution.\n    plan (CurriculumPlan | None): The curriculum plan data.\n    validation (ValidationResult | None): Generation validation data.\n    storyboard (Storyboard | None): The storyboard data.\n    manim_code (str | None): The generated Manim Python code.\n    video_url (str | None): URL to the final rendered video.\n    error (str | None): Error message if the job failed.\n    mode (str): Execution mode ('live' for API calls, 'mock' for simulation).\n    streamed_thoughts (list[ThoughtLog]): Live stream of agent thoughts."
      },
      "ProviderModels": {
        "properties": {
          "provider": { "type": "string", "title": "Provider" },
          "models": { "items": { "type": "string" }, "type": "array", "title": "Models" },
          "display_name": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": ["provider", "models"],
        "title": "ProviderModels"
      },
      "Scene": {
        "properties": {
          "scene_id": { "type": "integer", "title": "Scene Id" },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Short title of the scene"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Detailed description of what happens visually"
          },
          "narration": {
            "type": "string",
            "title": "Narration",
            "description": "Voiceover script for this scene"
          },
          "objects": {
            "items": { "$ref": "#/components/schemas/VisualObject" },
            "type": "array",
            "title": "Objects",
            "description": "Visual entities"
          }
        },
        "type": "object",
        "required": ["scene_id", "title", "description", "narration"],
        "title": "Scene",
        "description": "A single scene in the storyboard, mapping to a Manim Scene class.\n\nAttributes:\n    scene_id (int): Sequential ID of the scene.\n    title (str): Short title of the scene.\n    description (str): Detailed visual description of the scene action.\n    narration (str): Voiceover script for this scene.\n    objects (list[VisualObject]): List of visual entities in the scene."
      },
      "Storyboard": {
        "properties": {
          "concept_title": { "type": "string", "title": "Concept Title" },
          "scenes": {
            "items": { "$ref": "#/components/schemas/Scene" },
            "type": "array",
            "title": "Scenes"
          }
        },
        "type": "object",
        "required": ["concept_title", "scenes"],
        "title": "Storyboard",
        "description": "A complete visual orchestration of a curriculum.\n\nAttributes:\n    concept_title (str): Title of the concept being visualized.\n    scenes (list[Scene]): Ordered list of scenes."
      },
      "TeachingStep": {
        "properties": {
          "step_id": {
            "type": "integer",
            "title": "Step Id",
            "description": "Sequential ID of the step"
          },
          "concept": {
            "type": "string",
            "title": "Concept",
            "description": "The specific sub-concept being taught"
          },
          "visual_metaphor": {
            "type": "string",
            "title": "Visual Metaphor",
            "description": "Visual analogy (e.g., 'climbing a hill' for gradient descent)"
          },
          "narration": {
            "type": "string",
            "title": "Narration",
            "description": "Voiceover script for this step"
          }
        },
        "type": "object",
        "required": ["step_id", "concept", "visual_metaphor", "narration"],
        "title": "TeachingStep",
        "description": "Represents a single step in the pedagogical sequence.\n\nAttributes:\n    step_id (int): Sequential ID of the step.\n    concept (str): The specific sub-concept being taught.\n    visual_metaphor (str): Visual analogy used for explanation.\n    narration (str): Voiceover script for this step."
      },
      "ThoughtLog": {
        "properties": {
          "agent": { "type": "string", "title": "Agent" },
          "phase": { "type": "string", "title": "Phase" },
          "content": { "type": "string", "title": "Content" },
          "ts": { "type": "string", "title": "Ts" }
        },
        "type": "object",
        "required": ["agent", "phase", "content", "ts"],
        "title": "ThoughtLog",
        "description": "Represents a single thought streamed from an agent."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "type": "array",
            "title": "Location"
          },
          "msg": { "type": "string", "title": "Message" },
          "type": { "type": "string", "title": "Error Type" },
          "input": { "title": "Input" },
          "ctx": { "type": "object", "title": "Context" }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      },
      "ValidationResult": {
        "properties": {
          "is_valid": {
            "type": "boolean",
            "title": "Is Valid",
            "description": "Whether the plan passes pedagogical standards"
          },
          "feedback": {
            "type": "string",
            "title": "Feedback",
            "description": "Constructive feedback or validation errors"
          },
          "suggestions": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Suggestions",
            "description": "Specific improvement ideas"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Additional metadata about the validation process"
          },
          "scores": {
            "additionalProperties": true,
            "type": "object",
            "title": "Scores",
            "description": "Quantitative scores for different pedagogical aspects"
          },
          "issues": {
            "items": { "additionalProperties": { "type": "string" }, "type": "object" },
            "type": "array",
            "title": "Issues",
            "description": "Detailed list of identified issues, each as a dictionary"
          }
        },
        "type": "object",
        "required": ["is_valid", "feedback"],
        "title": "ValidationResult",
        "description": "Pedagogical validation results for a curriculum plan.\n\nAttributes:\n    is_valid (bool): Whether the plan passes pedagogical standards.\n    feedback (str): Constructive feedback or validation errors.\n    suggestions (list[str]): Specific ideas for improvement.\n    metadata (dict): Additional metadata about the validation process.\n    scores (dict): Quantitative scores for pedagogical aspects.\n    issues (list[dict]): Detailed list of identified issues."
      },
      "VisualObject": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Internal name (e.g., 'main_graph')"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Manim type (e.g., 'Axes', 'FunctionGraph', 'Dot')"
          },
          "position": {
            "type": "string",
            "title": "Position",
            "description": "Relative position (e.g., 'ORIGIN', 'UP * 2')"
          },
          "color": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Color",
            "description": "Hex or Manim color constant"
          },
          "label": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Label",
            "description": "Latex or text label"
          }
        },
        "type": "object",
        "required": ["name", "type", "position"],
        "title": "VisualObject",
        "description": "Represents a visual entity in a Manim scene.\n\nAttributes:\n    name (str): Internal name for the object (e.g., 'main_graph').\n    type (str): Manim class type (e.g., 'Axes', 'Dot').\n    position (str): Relative position or coordinates.\n    color (str | None): Color specification (Hex or Manim constant).\n    label (str | None): Optional text or Latex label."
      }
    }
  }
}
