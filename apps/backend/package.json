{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn main:app --app-dir src --reload --host 0.0.0.0 --port 8000",
    "worker": "uv run taskiq worker infra.tasks:broker --fs-root src",
    "lint": "uv run ruff check .",
    "update": "uv lock --upgrade && uv sync --all-extras",
    "bootstrap": "uv sync --all-extras"
  }
}
