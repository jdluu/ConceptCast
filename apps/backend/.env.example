# --- Infisical Configuration (Priority) ---
# Generate these in the Infisical Dashboard (Project Settings > Machine Identities)
INFISICAL_TOKEN=your_machine_identity_client_secret
INFISICAL_PROJECT_ID=your_infisical_project_id
INFISICAL_ENV=dev
INFISICAL_URL=https://app.infisical.com

# --- Fallback Configuration (Used if Infisical is not configured or key is missing) ---
# AI Provider Keys
GOOGLE_API_KEY=your_google_api_key
GROQ_API_KEY=your_groq_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
SYNTHETIC_API_KEY=your_synthetic_api_key

# Database
DATABASE_URL=sqlite:///../../conceptcast.db

# API Settings
CORS_ORIGINS=http://localhost:5173
PORT=8000
HOST=0.0.0.0
