# ==============================================================================
# ConceptCast Monorepo Configuration Template
# ==============================================================================

# --- Configuration (Local Development) ---
# These are used if Infisical is not configured or if a key is missing.

# [Backend] AI Provider Keys
GOOGLE_API_KEY=your_google_api_key
GROQ_API_KEY=your_groq_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
SYNTHETIC_API_KEY=your_synthetic_api_key
CONTEXT7_API_KEY=your_context7_api_key

# Optional overrides (defaults are in backend settings):
# DATABASE_URL=sqlite:///./conceptcast.db
# CORS_ORIGINS=http://localhost:5173
# RENDER_QUALITY=ql
# CONTEXT7_CACHE_TTL_SECONDS=1800
# CONTEXT7_CACHE_MAX_ENTRIES=256
# CONTEXT7_MAX_RETRIES=2
# STREAMED_THOUGHTS_MAX_ENTRIES=500

# REDIS_URL=redis://localhost:6379

# [Frontend] Optional Vite override (defaults to http://localhost:8000 in code):
# VITE_API_url=http://localhost:8000
