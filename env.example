# ==============================================================================
# ConceptCast Monorepo Configuration Template
# ==============================================================================

# --- Configuration (Local Development) ---
# These are used if Infisical is not configured or if a key is missing.

# [Backend] AI Provider Keys
GOOGLE_API_KEY=your_google_api_key
GROQ_API_KEY=your_groq_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
SYNTHETIC_API_KEY=your_synthetic_api_key

# [Backend] Core Settings
DATABASE_URL=sqlite:///./conceptcast.db
CORS_ORIGINS=http://localhost:5173
PORT=8000
HOST=0.0.0.0

# [Frontend] Vite Environment Variables
# Note: Vite requires 'VITE_' prefix for variables to be exposed to the client.
VITE_API_url=http://localhost:8000
