{
  "$schema": "https://v2-9-6.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {},
    "format": {},
    "typecheck": {
      "cache": true,
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "worker": {
      "cache": false,
      "persistent": true
    },
    "generate:api": {
        "cache": false
    },
    "bootstrap": {
      "cache": false
    },
    "update": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "NANO_API_KEY",
    "CONTEXT7_API_KEY",
    "DATABASE_URL",
    "REDIS_URL",
    "CORS_ORIGINS",
    "NANO_MODEL_NAME",
    "RENDER_QUALITY",
    "FRONTEND_DIST",
    "USE_INFISICAL"
  ]
}
